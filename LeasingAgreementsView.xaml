<UserControl x:Class="Trailer_Rental.LeasingAgreementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Trailer_Rental"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="Header" Height="2*"/>
            <RowDefinition x:Name="MainBody" Height="7*"/>
            <RowDefinition x:Name="Footer" Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Trailer Rental" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="100" FontWeight="Bold">
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF1183" Offset="0"/>
                    <GradientStop Color="#FF8000" Offset="1"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0 0 0 10">
                <Border Background="#F66C09" Width="50" Height="25" CornerRadius="8" Margin="0 0 10 0"/>
                <Border Background="#FF8B38" Width="50" Height="25" CornerRadius="8" Margin="0 0 10 0"/>
                <Border Background="#FFB783" Width="50" Height="25" CornerRadius="8"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0 0 0 10">
                <Border Background="#FF8B38" Width="50" Height="25" CornerRadius="8" Margin="0 0 10 0"/>
                <Border Background="#FFB783" Width="50" Height="25" CornerRadius="8" Margin="0 0 10 0"/>
                <Border Background="#FFD6B8" Width="50" Height="25" CornerRadius="8"/>
            </StackPanel>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Border Background="#FFB783" Width="50" Height="25" CornerRadius="8" Margin="0 0 10 0"/>
                <Border Background="#FFD6B8" Width="50" Height="25" CornerRadius="8" Margin="0 0 10 0"/>
                <Border Background="#FFE9D9" Width="50" Height="25" CornerRadius="8"/>
            </StackPanel>
        </StackPanel>

        <Button x:Name="LeasingAgreementViewButtonBackToStartView" Content="Back to Start View" Click="LeasingAgreementViewButtonBackToStartView_Click" Grid.Column="0" Grid.Row="1" Background="#F66C09"/>

    </Grid>
</UserControl>
